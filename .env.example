# -----------------------------------------------------------------------------
# Plantilla de variables de entorno. Copiar este archivo como ".env" y
# completar con valores reales. El archivo ".env" NUNCA se sube al
# repositorio (ver .gitignore) — así se evita que una credencial real
# quede expuesta en el código del workflow o en el historial de commits.
# -----------------------------------------------------------------------------

# --- PostgreSQL: superusuario de inicialización ---
# Este usuario solo se usa una vez, al crear el contenedor, para correr los
# scripts de sql/init/. La aplicación (n8n) NO usa este usuario.
POSTGRES_DB=vm_orchestration
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=cambiar_esta_clave

# --- PostgreSQL: usuario restringido que usará n8n ---
# Permisos limitados a SELECT/INSERT/UPDATE (ver sql/init/02_app_user.sql).
POSTGRES_APP_USER=n8n_app
POSTGRES_APP_PASSWORD=cambiar_esta_clave_tambien

# --- GVM/Greenbone: usuario admin de GMP ---
# gvmd autocrea este usuario con password "admin" en su primer arranque;
# esta variable es solo para tener documentado a qué se cambió, y para que
# el workflow de n8n la use al armar la credencial GMP.
GVM_ADMIN_USER=admin
GVM_ADMIN_PASSWORD=cambiar_esta_clave_de_gvm_tambien
