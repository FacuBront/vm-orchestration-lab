# -----------------------------------------------------------------------------
# Plantilla de variables de entorno. Copiar este archivo como ".env" y
# completar con valores reales. El archivo ".env" NUNCA se sube al
# repositorio (ver .gitignore) — así se evita que una credencial real
# quede expuesta en el código del workflow o en el historial de commits.
# -----------------------------------------------------------------------------

# --- PostgreSQL: superusuario de inicialización ---
# Este usuario solo se usa una vez, al crear el contenedor, para correr los
# scripts de sql/init/. La aplicación (n8n) NO usa este usuario.
POSTGRES_DB=vm_orchestration
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=cambiar_esta_clave

# --- PostgreSQL: usuario restringido que usará n8n ---
# Permisos limitados a SELECT/INSERT/UPDATE (ver sql/init/02_app_user.sql).
POSTGRES_APP_USER=n8n_app
POSTGRES_APP_PASSWORD=cambiar_esta_clave_tambien

# --- GVM/Greenbone: usuario admin de GMP ---
# gvmd autocrea este usuario con password "admin" en su primer arranque;
# esta variable es solo para tener documentado a qué se cambió, y para que
# el workflow de n8n la use al armar la credencial GMP.
GVM_ADMIN_USER=admin
GVM_ADMIN_PASSWORD=cambiar_esta_clave_de_gvm_tambien

# --- Frontend MVP (docker-compose.frontend.yml) ---
# Cadena de conexión del frontend a PostgreSQL (host "postgres" dentro de
# labnet). Por defecto usa el mismo usuario restringido de n8n y solo hace
# SELECT; si corriste sql/manual/03_frontend_readonly.sql, poné acá el rol de
# solo lectura. Si la contraseña tiene caracteres especiales (@ : / #),
# codificalos en formato URL (p. ej. @ -> %40).
DATABASE_URL=postgresql://n8n_app:cambiar_esta_clave_tambien@postgres:5432/vm_orchestration
# Webhook del workflow copia (vm-pipeline-lab-apache-webhook.json). Solo
# responde si ese workflow está importado y ACTIVO en n8n.
N8N_WEBHOOK_URL=http://n8n:5678/webhook/lanzar-escaneo
# Clave para firmar la cookie de sesión de Flask. Generá una propia con:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=cambiar_por_una_clave_aleatoria_larga
# Único usuario administrador del panel.
FRONTEND_ADMIN_USER=admin
# Contraseña de ese usuario. Puede ser texto (se hashea al arrancar) o un hash
# de werkzeug ya generado (empieza con "scrypt:" o "pbkdf2:"). Nunca se
# compara en texto plano.
FRONTEND_ADMIN_PASSWORD=cambiar_esta_clave_del_panel
